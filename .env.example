# Copy to .env for local overrides. No AWS credentials are needed for local development.
CODENTA_ENV=dev
CODENTA_DATABASE_URL=sqlite:///./codenta_diag.db
# "deterministic" (default, labelled demo policy, no API key) or "claude" (needs ANTHROPIC_API_KEY)
CODENTA_REASONER=deterministic
CODENTA_LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
CODENTA_WORKER_CONCURRENCY=4
CODENTA_QUEUE_SOFT_LIMIT=200
CODENTA_QUEUE_HARD_LIMIT=1000
# Set to 1 to run the worker pool inside the API process (single-process local mode)
CODENTA_RUN_WORKERS=1
CODENTA_LOG_LEVEL=INFO
# Production: provide real keys (or replace with OIDC) and set CODENTA_ENV=production; dev keys are then refused.
# CODENTA_API_KEYS_JSON={"<key>": {"principal": "qa-1", "role": "reporter", "practices": ["P-..."]}}
